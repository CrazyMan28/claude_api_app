{
  "name": "claude-api-app",
  "productName": "Forge",
  "version": "1.0.0",
  "description": "Windows and Linux desktop coding agent powered directly by the Anthropic Messages API",
  "main": "./out/main/index.js",
  "author": "CrazyMan28",
  "desktopName": "forge.desktop",
  "homepage": "https://github.com/CrazyMan28/claude_api_app",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "test:e2e": "electron-vite build && node e2e/ui.e2e.mjs",
    "icon": "node build/make-icon.mjs",
    "build:mobile": "vite build -c vite.mobile.config.mts",
    "android:sync": "npm run build:mobile && cap sync android",
    "android:apk": "npm run android:sync && cd mobile/android && ./gradlew assembleRelease",
    "test:e2e:mobile": "electron-vite build && vite build -c vite.mobile.config.mts && node e2e/mobile.e2e.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "diff": "^9.0.0",
    "qrcode": "^1.5.4",
    "tinyglobby": "^0.2.15",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/device": "^8.0.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "dompurify": "^3.4.17",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "framer-motion": "^14.4.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.60.0",
    "marked": "^18.1.1",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
